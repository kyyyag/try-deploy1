---
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';
import BranchesSection from '../components/BranchesSection.astro';
import { siteConfig } from '../data/siteConfig.js';

const title = `Kontak & Kantor Layanan | ${siteConfig.company.name}`;
const description = `Hubungi admin WhatsApp ${siteConfig.company.name} atau kunjungi kantor layanan kami di Surabaya.`;
---

<Layout 
  title={title}
  description={description}
>

  <!-- Page Header -->
  <div class="bg-gradient-to-b from-indigo-50/60 to-white py-16 sm:py-20 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block text-xs font-black tracking-widest text-emerald-600 uppercase mb-2">
        Hubungi & Kunjungi Kami
      </span>
      <h1 class="text-4xl sm:text-5xl font-black text-gray-950 tracking-tight">
        Kontak & Lokasi Kantor Surabaya
      </h1>
      <p class="mt-4 text-base sm:text-lg text-gray-600 max-w-2xl mx-auto">
        Layanan pelanggan 24/7 dan tim representatif kami siap melayani kebutuhan konektivitas internet Anda di wilayah Surabaya dan sekitarnya.
      </p>
    </div>
  </div>

  <!-- Interactive Contact Form & WhatsApp Trigger -->
  <ContactSection />

  <!-- Surabaya Branch / Office Location -->
  <BranchesSection />
</Layout>
