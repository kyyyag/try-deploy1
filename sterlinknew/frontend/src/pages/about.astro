---
import Layout from '../layouts/Layout.astro';
import AboutSection from '../components/AboutSection.astro';
import BranchesSection from '../components/BranchesSection.astro';
import { siteConfig } from '../data/siteConfig.js';
const waLink = siteConfig.getWaLink("Halo Admin SterlinkNet, saya ingin bertanya seputar profil dan kerjasama perusahaan.");
---

<Layout 
  title={`Tentang Kami | ${siteConfig.company.name}`}
  description={`Mengenal lebih dekat ${siteConfig.company.name}, penyedia layanan internet fiber optic terpercaya tahun ${siteConfig.company.establishedYear}.`}
>
  <!-- Page Header -->
  <div class="bg-gradient-to-b from-[#0d0d2b] to-[#0a0a1a] py-16 sm:py-20 border-b border-indigo-500/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block text-xs font-black tracking-widest text-indigo-400 uppercase mb-2">
        Profil Perusahaan
      </span>
      <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight flex flex-wrap items-center justify-center gap-3">
        Tentang 
        <img 
          src="/images/sterlink-name.png" 
          alt={siteConfig.company.name} 
          class="h-8 sm:h-10 w-auto object-contain brightness-0 invert inline-block -mt-1"
        />
      </h1>
      <p class="mt-4 text-base sm:text-lg text-gray-400 max-w-2xl mx-auto">
        Menghubungkan masyarakat dengan koneksi internet cepat, stabil, dan infrastruktur 100% fiber optic murni di tahun {siteConfig.company.establishedYear}.
      </p>
    </div>
  </div>

  <!-- Main About Content Component -->
  <AboutSection />

  <!-- Commitment & Service Highlights -->
  <section class="py-20 bg-[#0a0a1a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center space-y-4 mb-16">
        <h2 class="text-3xl font-black text-white">Komitmen & Keunggulan Layanan Kami</h2>
        <p class="text-gray-400 text-sm sm:text-base">
          <img src="/images/sterlink-name.png" alt={siteConfig.company.name} class="h-4 w-auto inline-block brightness-0 invert -mt-1 mr-1" />
          hadir memberikan solusi internet berkecepatan tinggi dengan standar kualitas terbaik untuk warga Surabaya.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        
        <div class="p-8 rounded-3xl glass-card hover:border-indigo-500/30 transition-all">
          <div class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-blue-400 mb-2">100% Fiber</div>
          <h3 class="text-base font-bold text-white mb-2">Koneksi Simetris 1:1</h3>
          <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
            Kecepatan upload dan download seimbang tanpa batasan kuota (True Unlimited No FUP) untuk kelancaran beraktivitas online.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-gradient-to-br from-indigo-900/20 to-[#0f0f2a] border border-indigo-500/20">
          <div class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400 mb-2">24 / 7</div>
          <h3 class="text-base font-bold text-white mb-2">Layanan Responsif</h3>
          <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
            Dukungan teknisi dan Customer Service yang siap melayani kebutuhan konsultasi, aktivasi, dan kendala teknis kapan pun.
          </p>
        </div>

        <div class="p-8 rounded-3xl glass-card hover:border-emerald-500/30 transition-all">
          <div class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-green-400 mb-2">99.9%</div>
          <h3 class="text-base font-bold text-white mb-2">Jaminan Uptime</h3>
          <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
            Infrastruktur jaringan handal yang dirancang untuk stabilitas maksimal saat streaming, gaming, meeting online, maupun bisnis.
          </p>
        </div>

      </div>

      <!-- CTA Box -->
      <div class="mt-16 text-center">
        <a 
          href={waLink} 
          target="_blank" 
          class="inline-flex items-center gap-2 px-8 py-4 rounded-xl text-base font-bold text-white bg-emerald-600 hover:bg-emerald-500 shadow-lg shadow-emerald-600/25 transition-all"
        >
          Hubungi Admin untuk Kerjasama / Info &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Branches / Office Location in Surabaya -->
  <BranchesSection />
</Layout>
