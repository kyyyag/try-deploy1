---
import { siteConfig } from "../data/siteConfig.js";
const waLink = siteConfig.getWaLink();
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<footer class="bg-[#060614] text-gray-400 border-t border-indigo-500/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      <!-- Company Overview -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <img
            src={`${base}images/Logo.png`}
            alt="Sterlink Logo"
            class="w-10 h-10 rounded-full object-contain drop-shadow-[0_0_8px_rgba(99,102,241,0.3)]"
          />
          <div class="flex flex-col">
            <img
              src={`${base}images/sterlink-name.png`}
              alt={siteConfig.company.name}
              class="h-6 w-auto object-contain brightness-0 invert opacity-90"
            />
            <span class="block text-xs font-semibold uppercase text-indigo-400 mt-1">
              Internet Service Provider
            </span>
          </div>
        </div>

        <p class="text-sm text-gray-500 leading-relaxed pr-6">
          {siteConfig.company.shortIdea}
        </p>

        <div class="pt-2 text-xs text-gray-500">
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#0f0f2a] text-indigo-300 border border-indigo-500/15 font-medium"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Layanan Fiber Optic Murni ({siteConfig.company.establishedYear})
          </span>
        </div>

        <!-- Social Media Icons (WA, FB, IG) -->
        <div class="flex items-center gap-3 pt-3">
          <!-- WhatsApp -->
          <a
            href={siteConfig.contact.socialMedia.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-white/5 hover:bg-emerald-600 text-gray-400 hover:text-white flex items-center justify-center transition-all border border-white/5 hover:border-emerald-500/30"
            aria-label="WhatsApp"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.178L2 22l4.98-1.395A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"></path>
            </svg>
          </a>

          <!-- Facebook -->
          <a
            href={siteConfig.contact.socialMedia.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-white/5 hover:bg-blue-600 text-gray-400 hover:text-white flex items-center justify-center transition-all border border-white/5 hover:border-blue-500/30"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"></path>
            </svg>
          </a>

          <!-- Instagram -->
          <a
            href={siteConfig.contact.socialMedia.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-white/5 hover:bg-pink-600 text-gray-400 hover:text-white flex items-center justify-center transition-all border border-white/5 hover:border-pink-500/30"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4">
          Navigasi
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href={base} class="hover:text-indigo-400 transition-colors">Home</a>
          </li>
          <li>
            <a href={`${base}about`} class="hover:text-indigo-400 transition-colors">Tentang Kami</a>
          </li>
          <li>
            <a href={`${base}packages`} class="hover:text-indigo-400 transition-colors">Paket Layanan</a>
          </li>
          <li>
            <a href={`${base}contact`} class="hover:text-indigo-400 transition-colors">Kontak & Cabang</a>
          </li>
        </ul>
      </div>

      <!-- Paket Layanan Summary -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4">
          Layanan Kami
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href={`${base}packages`} class="hover:text-indigo-400 transition-colors">Internet Rumah (Fiber)</a>
          </li>
          <li>
            <a href={siteConfig.getCSWaLink("Halo CS SterlinkNet, saya tertarik dengan layanan Internet Bisnis & UKM.")} target="_blank" class="hover:text-indigo-400 transition-colors">Internet Bisnis & UKM</a>
          </li>
          <li>
            <a href={siteConfig.getCSWaLink("Halo CS SterlinkNet, saya tertarik dengan layanan Dedicated Corporate.")} target="_blank" class="hover:text-indigo-400 transition-colors">Dedicated Corporate</a>
          </li>
          <li>
            <a href={waLink} target="_blank" class="hover:text-indigo-400 transition-colors">Konsultasi Custom Jaringan</a>
          </li>
        </ul>
      </div>

      <!-- Multi-City Branches -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4">
          Kota Layanan
        </h4>
        <ul class="space-y-2.5 text-sm">
          {
            siteConfig.branchAddresses.map((branch) => (
              <li class="flex items-center gap-2">
                <svg
                  class="w-3.5 h-3.5 text-indigo-400 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>
                <span>{branch.city}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div
      class="mt-12 pt-8 border-t border-indigo-500/10 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-600 gap-4"
    >
      <p>
        &copy; {siteConfig.company.establishedYear}
        {siteConfig.company.name}. Hak Cipta Dilindungi.
      </p>
      <p class="flex items-center gap-1">
        Penyedia Layanan Internet Berkecepatan Tinggi
      </p>
    </div>
  </div>
</footer>
