---
import { siteConfig } from "../data/siteConfig.js";
const waLink = siteConfig.getWaLink(
  "Halo Admin SterlinkNet, saya ingin konsultasi paket internet yang cocok untuk kebutuhan saya.",
);
---

<section
  class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28 bg-gradient-to-b from-[#0a0a1a] via-[#0d0d2b] to-[#0a0a1a]"
>
  <!-- Decorative background orbs -->
  <div class="absolute top-20 left-1/4 w-96 h-96 bg-indigo-600/8 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-10 right-1/4 w-80 h-80 bg-purple-600/8 rounded-full blur-[100px] pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-blue-600/5 rounded-full blur-[150px] pointer-events-none"></div>

  <!-- Grid pattern overlay -->
  <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2240%22%20height%3D%2240%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M40%200H0v40%22%20fill%3D%22none%22%20stroke%3D%22rgba(99%2C102%2C241%2C0.03)%22%20stroke-width%3D%221%22%2F%3E%3C%2Fsvg%3E')] pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Content -->
      <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
        <!-- Category Badge -->
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 text-xs sm:text-sm font-semibold"
        >
          <span class="flex h-2 w-2 rounded-full bg-indigo-400 animate-ping"></span>
          <span>Penyedia Layanan Internet (ISP) Fiber Optic {siteConfig.company.establishedYear}</span>
        </div>

        <!-- Main Heading -->
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.15]"
        >
          Koneksi Internet <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-blue-400 to-purple-400 text-glow"
            >Cepat, Stabil & Tanpa FUP</span>
        </h1>

        <!-- Short Description -->
        <p
          class="text-lg sm:text-xl text-gray-400 leading-relaxed max-w-2xl mx-auto lg:mx-0"
        >
          {siteConfig.company.shortIdea} Nikmati kecepatan murni simetris untuk streaming
          4K, kerja dari rumah, gaming tanpa lag, hingga kebutuhan bisnis.
        </p>

        <!-- CTA Buttons -->
        <div
          class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2"
        >
          <!-- Primary WhatsApp CTA -->
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl text-base font-bold text-white bg-emerald-600 hover:bg-emerald-500 active:scale-[0.98] shadow-lg shadow-emerald-600/25 hover:shadow-emerald-500/30 transition-all"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path
                d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.178L2 22l4.98-1.395A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"
              ></path>
            </svg>
            Pasang Sekarang via WhatsApp
          </a>

          <!-- View Packages CTA -->
          <a
            href="/packages"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-base font-bold text-gray-200 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-indigo-500/30 transition-all"
          >
            Lihat Paket Layanan
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <!-- Highlight Features Grid -->
        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-white/10">
          <div>
            <div class="text-2xl sm:text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-blue-400">
              99.5%
            </div>
            <div class="text-xs sm:text-sm text-gray-500 font-medium mt-1">
              Uptime SLA
            </div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-400">
              100%
            </div>
            <div class="text-xs sm:text-sm text-gray-500 font-medium mt-1">
              Fiber Optic Murni
            </div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400">
              24/7
            </div>
            <div class="text-xs sm:text-sm text-gray-500 font-medium mt-1">
              Dukungan Teknisi
            </div>
          </div>
        </div>
      </div>

      <!-- Right Visual Card (Interactive ISP Visual) -->
      <div class="lg:col-span-5 relative">
        <div
          class="relative mx-auto max-w-md lg:max-w-none rounded-3xl bg-gradient-to-tr from-[#0f0f2a] via-[#131340] to-[#0f0f2a] p-8 text-white shadow-2xl overflow-hidden border border-indigo-500/20 glow-indigo"
        >
          <!-- Decorative Glow -->
          <div class="absolute -top-12 -right-12 w-48 h-48 bg-indigo-500/20 rounded-full blur-3xl animate-glow-pulse"></div>
          <div class="absolute -bottom-12 -left-12 w-48 h-48 bg-blue-500/15 rounded-full blur-3xl animate-glow-pulse" style="animation-delay: 1.5s;"></div>

          <!-- Card Header -->
          <div class="relative z-10 flex items-center justify-between border-b border-indigo-500/20 pb-6">
            <div>
              <div class="text-xs font-semibold text-indigo-400 uppercase tracking-wider">
                Live Network Status
              </div>
              <div class="text-lg font-bold text-white mt-0.5">
                Sterlink High-Speed Fiber
              </div>
            </div>
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-300 text-xs font-bold border border-emerald-500/20"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Ultra Optimal
            </span>
          </div>

          <!-- Speed Meter Display -->
          <div class="relative z-10 py-8 text-center">
            <div
              class="text-5xl sm:text-6xl font-black text-transparent bg-clip-text bg-gradient-to-r from-white via-indigo-200 to-blue-300 tracking-tight"
            >
              1,000 <span class="text-2xl sm:text-3xl font-bold text-indigo-400">Mbps</span>
            </div>
            <p class="text-xs sm:text-sm text-indigo-300/60 mt-2">
              Bandwidth Simetris (Upload = Download)
            </p>
          </div>

          <!-- Interactive Speed Features -->
          <div
            class="relative z-10 space-y-3 bg-[#0a0a1a]/60 rounded-2xl p-4 border border-indigo-500/15"
          >
            <div class="flex items-center justify-between text-xs">
              <span class="text-gray-400">Ping / Latency</span>
              <span class="font-bold text-emerald-400">&lt; 3 ms (Ultra Low)</span>
            </div>
            <div class="w-full bg-[#1a1a3a] rounded-full h-2">
              <div class="bg-gradient-to-r from-emerald-400 to-indigo-400 h-2 rounded-full w-[95%]"></div>
            </div>

            <div class="flex items-center justify-between text-xs pt-1">
              <span class="text-gray-400">Coverage Jaringan</span>
              <span class="font-bold text-indigo-300">Surabaya & Sekitarnya</span>
            </div>
          </div>

          <!-- Quick Action direct to WA -->
          <div class="relative z-10 mt-6 text-center">
            <a
              href={waLink}
              target="_blank"
              class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-xs sm:text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-500 transition-colors shadow-md shadow-indigo-600/20"
            >
              Cek Jangkauan Alamat Anda Sekarang &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
