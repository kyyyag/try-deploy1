---
import { siteConfig } from '../data/siteConfig.js';
const defaultWaLink = siteConfig.getWaLink();
---

<section id="contact" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold uppercase tracking-wider">
        Hubungi Kami
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight">
        Konsultasi & Pasang Internet Mudah
      </h2>
      <p class="text-base sm:text-lg text-gray-600">
        Hubungi tim customer care dan sales kami melalui WhatsApp langsung, sosial media, atau kunjungi kantor cabang terdekat.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Contact Cards & Socials -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- WhatsApp Official Cards Grid -->
        <div class="space-y-3">
          <!-- WhatsApp Utama -->
          <a 
            href={defaultWaLink}
            target="_blank"
            rel="noopener noreferrer"
            class="block p-5 rounded-2xl bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-200/80 shadow-xs hover:shadow-md transition-all group"
          >
            <div class="flex items-center gap-4">
              <div class="w-11 h-11 rounded-xl bg-emerald-600 text-white flex items-center justify-center shadow-md group-hover:scale-105 transition-transform shrink-0">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.178L2 22l4.98-1.395A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
                </svg>
              </div>
              <div>
                <div class="text-[11px] font-bold uppercase text-emerald-800 tracking-wider">WhatsApp Utama (Fast Response)</div>
                <div class="text-base font-black text-gray-900">{siteConfig.contact.whatsappDisplay}</div>
                <div class="text-xs text-emerald-700 font-medium">Klik untuk chat &rarr;</div>
              </div>
            </div>
          </a>

          <!-- WhatsApp Informasi Aktivasi & Paket -->
          <a 
            href={siteConfig.getActivationWaLink()}
            target="_blank"
            rel="noopener noreferrer"
            class="block p-5 rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200/80 shadow-xs hover:shadow-md transition-all group"
          >
            <div class="flex items-center gap-4">
              <div class="w-11 h-11 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-md group-hover:scale-105 transition-transform shrink-0">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.178L2 22l4.98-1.395A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
                </svg>
              </div>
              <div>
                <div class="text-[11px] font-bold uppercase text-blue-800 tracking-wider">WA Informasi Aktivasi & Paket</div>
                <div class="text-base font-black text-gray-900">{siteConfig.contact.whatsappActivationDisplay}</div>
                <div class="text-xs text-blue-700 font-medium">Klik untuk chat info &rarr;</div>
              </div>
            </div>
          </a>

          <!-- WhatsApp CS -->
          <a 
            href={siteConfig.getCSWaLink()}
            target="_blank"
            rel="noopener noreferrer"
            class="block p-5 rounded-2xl bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200/80 shadow-xs hover:shadow-md transition-all group"
          >
            <div class="flex items-center gap-4">
              <div class="w-11 h-11 rounded-xl bg-amber-600 text-white flex items-center justify-center shadow-md group-hover:scale-105 transition-transform shrink-0">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.178L2 22l4.98-1.395A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
                </svg>
              </div>
              <div>
                <div class="text-[11px] font-bold uppercase text-amber-800 tracking-wider">WhatsApp Customer Service</div>
                <div class="text-base font-black text-gray-900">{siteConfig.contact.whatsappCSDisplay}</div>
                <div class="text-xs text-amber-700 font-medium">Klik untuk hubungi CS &rarr;</div>
              </div>
            </div>
          </a>
        </div>

        <!-- Email & Support Card -->
        <div class="p-6 rounded-3xl bg-gray-50 border border-gray-200/80 space-y-4 text-sm text-gray-700">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <div class="text-xs text-gray-500 font-medium">Email / Kontak</div>
              <div class="font-bold text-gray-900">{siteConfig.contact.email}</div>
            </div>
          </div>

          <div class="flex items-center gap-3 pt-2 border-t border-gray-200">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <div class="text-xs text-gray-500 font-medium">Jam Layanan NOC</div>
              <div class="font-bold text-gray-900">{siteConfig.contact.supportHours}</div>
            </div>
          </div>
        </div>

        <!-- Social Media Channel Box -->
        <div class="p-6 rounded-3xl bg-indigo-900 text-white space-y-3">
          <h4 class="text-sm font-bold uppercase tracking-wider text-indigo-300">Sosial Media Resmi</h4>
          <p class="text-xs text-indigo-100">Ikuti update promo jaringan, event, dan informasi infrastruktur terbaru:</p>
          <div class="flex items-center gap-3 pt-2">
            <a href={siteConfig.contact.socialMedia.whatsapp} target="_blank" class="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-xs font-bold transition-colors">
              WhatsApp
            </a>
            <a href={siteConfig.contact.socialMedia.facebook} target="_blank" class="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-xs font-bold transition-colors">
              Facebook
            </a>
            <a href={siteConfig.contact.socialMedia.instagram} target="_blank" class="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-xs font-bold transition-colors">
              Instagram
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive WhatsApp Launcher Form -->
      <div class="lg:col-span-7 bg-white rounded-3xl p-8 sm:p-10 border border-gray-200 shadow-lg">
        <h3 class="text-2xl font-black text-gray-900 mb-2">Kirim Pesan Cepat ke Admin</h3>
        <p class="text-sm text-gray-500 mb-8">
          Isi form di bawah ini dan tekan tombol kirim untuk langsung tersambung ke WhatsApp admin resmi kami dengan format pesan otomatis.
        </p>

        <form id="wa-quick-form" class="space-y-5">
          <div>
            <label for="wa-name" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Nama Lengkap</label>
            <input 
              type="text" 
              id="wa-name" 
              required 
              placeholder="Contoh: Budi Santoso"
              class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="wa-city" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Kota / Lokasi Pemasangan</label>
              <select 
                id="wa-city" 
                class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm bg-white"
              >
                {siteConfig.branchAddresses.map(b => (
                  <option value={b.city}>{b.city}</option>
                ))}
                <option value="Kota Lainnya">Kota Lainnya</option>
              </select>
            </div>

            <div>
              <label for="wa-package" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Pilihan Paket Layanan</label>
              <select 
                id="wa-package" 
                class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm bg-white"
              >
                {siteConfig.packages.map(p => (
                  <option value={p.name}>{p.name} ({p.speed})</option>
                ))}
                <option value="Konsultasi Custom Jaringan">Konsultasi Custom Jaringan</option>
              </select>
            </div>
          </div>

          <div>
            <label for="wa-notes" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Catatan Tambahan (Opsional)</label>
            <textarea 
              id="wa-notes" 
              rows="3" 
              placeholder="Contoh: Mohon info ketersediaan tiang fiber di perumahan saya..."
              class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full flex items-center justify-center gap-3 py-4 px-6 rounded-xl text-base font-bold text-white bg-emerald-600 hover:bg-emerald-700 active:scale-98 shadow-lg shadow-emerald-600/25 transition-all cursor-pointer"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.178L2 22l4.98-1.395A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
            </svg>
            Kirim & Langsung Chat Admin WhatsApp
          </button>
        </form>
      </div>

    </div>

  </div>
</section>

<!-- Script to construct dynamic WA Link and redirect -->
<script define:vars={{ waNumber: siteConfig.contact.whatsappNumber }}>
  const form = document.getElementById('wa-quick-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('wa-name')).value.trim();
      const city = (document.getElementById('wa-city')).value;
      const pkg = (document.getElementById('wa-package')).value;
      const notes = (document.getElementById('wa-notes')).value.trim();

      let msg = `Halo Admin SterlinkNet, perkenalkan saya *${name}*.\n`;
      msg += `📍 Lokasi Pemasangan: *${city}*\n`;
      msg += `📦 Paket yang Diminati: *${pkg}*\n`;
      if (notes) {
        msg += `📝 Catatan: ${notes}\n`;
      }
      msg += `\nMohon info ketersediaan jaringan dan jadwal pemasangan. Terima kasih!`;

      const targetUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;
      window.open(targetUrl, '_blank');
    });
  }
</script>
