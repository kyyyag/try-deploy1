---
import { siteConfig } from '../data/siteConfig.js';
---

<section id="packages" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold uppercase tracking-wider">
        Pilihan Paket Internet
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight">
        Paket Layanan Fiber Super Cepat
      </h2>
      <p class="text-base sm:text-lg text-gray-600">
        Pilih paket internet sesuai kebutuhan Anda dengan kecepatan 20 Mbps, 35 Mbps, hingga 50 Mbps. Tanpa batas kuota (FUP) dan 100% Fiber Optic.
      </p>
    </div>

    <!-- Interactive Speed Filter Tabs -->
    <div class="mt-10 flex items-center justify-center gap-2 sm:gap-4 flex-wrap">
      <button 
        type="button" 
        data-filter="all" 
        class="filter-btn active px-6 py-2.5 rounded-full text-sm font-bold transition-all bg-indigo-600 text-white shadow-md cursor-pointer"
      >
        ⚡ Semua Paket
      </button>
      <button 
        type="button" 
        data-filter="20mbps" 
        class="filter-btn px-6 py-2.5 rounded-full text-sm font-bold transition-all bg-gray-100 text-gray-700 hover:bg-gray-200 cursor-pointer"
      >
        🚀 20 Mbps
      </button>
      <button 
        type="button" 
        data-filter="35mbps" 
        class="filter-btn px-6 py-2.5 rounded-full text-sm font-bold transition-all bg-gray-100 text-gray-700 hover:bg-gray-200 cursor-pointer"
      >
        ⚡ 35 Mbps
      </button>
      <button 
        type="button" 
        data-filter="50mbps" 
        class="filter-btn px-6 py-2.5 rounded-full text-sm font-bold transition-all bg-gray-100 text-gray-700 hover:bg-gray-200 cursor-pointer"
      >
        🔥 50 Mbps
      </button>
    </div>

    <!-- Interactive Package Cards Grid -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {siteConfig.packages.map((pkg) => {
        const orderWaLink = siteConfig.getPackageWaLink(
          `${pkg.name} (${pkg.duration})`, 
          pkg.speed, 
          `${pkg.price}${pkg.activationFee ? ` + Aktivasi Rp ${pkg.activationFee}` : ''}`
        );
        return (
          <div 
            class={`package-card flex flex-col justify-between rounded-3xl p-6 border transition-all duration-300 ${
              pkg.isPopular 
                ? 'bg-gradient-to-b from-indigo-900/5 via-white to-white border-indigo-500 shadow-xl relative ring-2 ring-indigo-500/20' 
                : 'bg-white border-gray-200 shadow-xs hover:shadow-lg hover:border-gray-300'
            }`}
            data-category={pkg.category}
          >
            {pkg.popularTag && (
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-gradient-to-r from-indigo-600 to-blue-600 text-white text-xs font-black uppercase tracking-wider shadow-md whitespace-nowrap">
                {pkg.popularTag}
              </div>
            )}

            <div>
              <!-- Package Title & Speed Badge -->
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700">
                  {pkg.duration}
                </span>
                <span class="text-xs font-bold text-gray-400">100% Fiber</span>
              </div>

              <h3 class="text-xl font-black text-gray-900 mb-1">{pkg.name}</h3>
              <p class="text-xs text-gray-500 mb-5">{pkg.description}</p>

              <!-- Speed & Price Highlight -->
              <div class="bg-gray-50 rounded-2xl p-4 mb-5 border border-gray-100 text-center">
                <div class="text-xs font-semibold text-indigo-600 uppercase tracking-wider mb-0.5">Kecepatan</div>
                <div class="text-2xl font-black text-gray-950">{pkg.speed}</div>
                
                <div class="mt-2.5 pt-2.5 border-t border-gray-200/80 flex items-baseline justify-center gap-1">
                  <span class="text-xs font-bold text-gray-500">Rp</span>
                  <span class="text-2xl font-black text-gray-900">{pkg.price}</span>
                  <span class="text-xs text-gray-500">/{pkg.duration.toLowerCase()}</span>
                </div>

                {pkg.activationFee && (
                  <div class="mt-2 text-[11px] font-semibold text-amber-700 bg-amber-50 rounded-lg py-1 px-2 border border-amber-200/60">
                    + Biaya Aktivasi Rp {pkg.activationFee}
                  </div>
                )}
              </div>

              <!-- Features list -->
              <div class="space-y-2 mb-6">
                <div class="text-xs font-bold text-gray-900 uppercase tracking-wider">Fasilitas Termasuk:</div>
                <ul class="space-y-2 text-xs text-gray-600">
                  {pkg.features.map((feat) => (
                    <li class="flex items-start gap-2">
                      <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Direct WhatsApp Order Action -->
            <div>
              <a
                href={orderWaLink}
                target="_blank"
                rel="noopener noreferrer"
                class={`w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-xs font-bold transition-all shadow-md active:scale-98 ${
                  pkg.isPopular
                    ? 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-emerald-600/25'
                    : 'bg-indigo-600 hover:bg-indigo-700 text-white shadow-indigo-600/20'
                }`}
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.178L2 22l4.98-1.395A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
                </svg>
                Pesan via WhatsApp
              </a>
            </div>

          </div>
        );
      })}
    </div>

    <!-- Custom Enterprise Banner -->
    <div class="mt-16 bg-gradient-to-r from-gray-900 to-indigo-950 rounded-3xl p-8 sm:p-10 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl">
      <div class="space-y-2 text-center md:text-left">
        <h3 class="text-2xl font-black">Butuh Kebutuhan Khusus / Proyek Gedung?</h3>
        <p class="text-sm text-gray-300 max-w-xl">
          Kami menyediakan solusi Dark Fiber, Metro-E, Multi-WAN failover, dan konsultasi jaringan IT korporasi skala besar di wilayah Surabaya.
        </p>
      </div>
      <a 
        href={siteConfig.getWaLink("Halo Admin SterlinkNet, saya tertarik berdiskusi mengenai proyek jaringan dedicated / corporate internet.")}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 inline-flex items-center gap-2 px-6 py-3.5 rounded-xl text-sm font-bold text-gray-900 bg-white hover:bg-gray-100 transition-colors shadow-md"
      >
        Konsultasi dengan Enterprise Specialist &rarr;
      </a>
    </div>

  </div>
</section>

<!-- Client-side Interactive Filter Script -->
<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.package-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Toggle active classes
      filterBtns.forEach(b => {
        b.classList.remove('active', 'bg-indigo-600', 'text-white', 'shadow-md');
        b.classList.add('bg-gray-100', 'text-gray-700');
      });
      btn.classList.add('active', 'bg-indigo-600', 'text-white', 'shadow-md');
      btn.classList.remove('bg-gray-100', 'text-gray-700');

      const filterValue = btn.getAttribute('data-filter');

      cards.forEach(card => {
        const category = card.getAttribute('data-category');
        if (filterValue === 'all' || category === filterValue) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
