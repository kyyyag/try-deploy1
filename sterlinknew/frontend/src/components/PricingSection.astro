---
import { siteConfig } from '../data/siteConfig.js';
---

<section id="packages" class="py-20 bg-[#0a0a1a]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 text-emerald-300 text-xs font-bold uppercase tracking-wider border border-emerald-500/20">
        Pilihan Paket Internet
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        Paket Layanan Fiber Super Cepat
      </h2>
      <p class="text-base sm:text-lg text-gray-400">
        Pilih paket internet sesuai kebutuhan Anda dengan kecepatan 20 Mbps, 35 Mbps, hingga 50 Mbps. Tanpa batas kuota (FUP) dan 100% Fiber Optic.
      </p>
    </div>



    <!-- Interactive Package Cards Grid — CENTERED max 3 columns -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {siteConfig.packages.map((pkg) => {
        const orderWaLink = siteConfig.getPackageWaLink(
          `${pkg.name} (${pkg.duration})`, 
          pkg.speed, 
          `${pkg.price}${pkg.activationFee ? ` + Aktivasi Rp ${pkg.activationFee}` : ''}`
        );
        return (
          <div 
            class={`package-card flex flex-col justify-between rounded-3xl p-6 transition-all duration-300 ${
              pkg.isPopular 
                ? 'bg-gradient-to-b from-indigo-900/30 via-[#0f0f2a] to-[#0f0f2a] border-indigo-500/40 shadow-xl relative ring-2 ring-indigo-500/20 glow-indigo border' 
                : 'glass-card hover:border-indigo-500/25 hover:shadow-lg hover:shadow-indigo-900/10'
            }`}
            data-category={pkg.category}
          >
            {pkg.popularTag && (
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-gradient-to-r from-indigo-600 to-blue-600 text-white text-xs font-black uppercase tracking-wider shadow-md shadow-indigo-600/30 whitespace-nowrap">
                {pkg.popularTag}
              </div>
            )}

            <div>
              <!-- Package Title & Speed Badge -->
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-lg bg-indigo-500/15 text-indigo-300 border border-indigo-500/20">
                  {pkg.duration}
                </span>
                <span class="text-xs font-bold text-gray-500">100% Fiber</span>
              </div>

              <h3 class="text-xl font-black text-white mb-1">{pkg.name}</h3>
              <p class="text-xs text-gray-500 mb-5">{pkg.description}</p>

              <!-- Speed & Price Highlight -->
              <div class="bg-[#0a0a1a]/60 rounded-2xl p-4 mb-5 border border-indigo-500/10 text-center">
                <div class="text-xs font-semibold text-indigo-400 uppercase tracking-wider mb-0.5">Kecepatan</div>
                <div class="text-2xl font-black text-white">{pkg.speed}</div>
                
                <div class="mt-2.5 pt-2.5 border-t border-indigo-500/10 flex items-baseline justify-center gap-1">
                  <span class="text-xs font-bold text-gray-500">Rp</span>
                  <span class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-indigo-300 to-blue-300">{pkg.price}</span>
                  <span class="text-xs text-gray-500">/{pkg.duration.toLowerCase()}</span>
                </div>

                {pkg.activationFee && (
                  <div class="mt-2 text-[11px] font-semibold text-amber-300 bg-amber-500/10 rounded-lg py-1 px-2 border border-amber-500/15">
                    + Biaya Aktivasi Rp {pkg.activationFee}
                  </div>
                )}
              </div>

              <!-- Features list -->
              <div class="space-y-2 mb-6">
                <div class="text-xs font-bold text-gray-300 uppercase tracking-wider">Fasilitas Termasuk:</div>
                <ul class="space-y-2 text-xs text-gray-400">
                  {pkg.features.map((feat) => (
                    <li class="flex items-start gap-2">
                      <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Direct WhatsApp Order Action -->
            <div>
              <a
                href={orderWaLink}
                target="_blank"
                rel="noopener noreferrer"
                class={`w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-xs font-bold transition-all shadow-md active:scale-[0.98] ${
                  pkg.isPopular
                    ? 'bg-emerald-600 hover:bg-emerald-500 text-white shadow-emerald-600/25'
                    : 'bg-indigo-600 hover:bg-indigo-500 text-white shadow-indigo-600/20'
                }`}
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.178L2 22l4.98-1.395A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
                </svg>
                Pesan via WhatsApp
              </a>
            </div>

          </div>
        );
      })}
    </div>

    <!-- Custom Enterprise Banner -->
    <div class="mt-16 bg-gradient-to-r from-[#0f0f2a] via-[#131340] to-[#0f0f2a] rounded-3xl p-8 sm:p-10 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl border border-indigo-500/15 glow-indigo">
      <div class="space-y-2 text-center md:text-left">
        <h3 class="text-2xl font-black">Butuh Kebutuhan Khusus / Proyek Gedung?</h3>
        <p class="text-sm text-gray-400 max-w-xl">
          Kami menyediakan solusi Konsultasi jaringan IT korporasi skala besar di wilayah Surabaya.
        </p>
      </div>
      <a 
        href={siteConfig.getWaLink("Halo Admin SterlinkNet, saya tertarik berdiskusi mengenai proyek jaringan dedicated / corporate internet.")}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 inline-flex items-center gap-2 px-6 py-3.5 rounded-xl text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-500 transition-colors shadow-md shadow-indigo-600/20"
      >
        Konsultasi dengan Enterprise Specialist &rarr;
      </a>
    </div>

  </div>
</section>
