---
import { siteConfig } from '../data/siteConfig.js';
const waLink = siteConfig.getWaLink("Halo Admin SterlinkNet, saya ingin bertanya tentang paket internet.");
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-xs transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <img 
          src="/images/Logo.png" 
          alt="Sterlink Logo" 
          class="w-10 h-10 object-contain mix-blend-multiply group-hover:scale-105 transition-transform" 
        />
        <div class="flex flex-col">
          <img 
            src="/images/sterlink-name.jpeg" 
            alt={siteConfig.company.name} 
            class="h-7 w-auto object-contain mix-blend-multiply"
          />
          <span class="text-[10px] font-semibold tracking-wider uppercase text-indigo-600 mt-0.5">
            Internet Service Provider
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="/" class="text-sm font-semibold text-gray-700 hover:text-indigo-600 transition-colors py-1">
          Home
        </a>
        <a href="/about" class="text-sm font-semibold text-gray-700 hover:text-indigo-600 transition-colors py-1">
          About Us
        </a>
        <a href="/packages" class="text-sm font-semibold text-gray-700 hover:text-indigo-600 transition-colors py-1">
          Paket Layanan
        </a>
        <a href="/contact" class="text-sm font-semibold text-gray-700 hover:text-indigo-600 transition-colors py-1">
          Kontak & Cabang
        </a>
      </nav>

      <!-- Action Button (WhatsApp Direct) -->
      <div class="hidden sm:flex items-center gap-3">
        <a 
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-700 active:scale-95 transition-all shadow-md shadow-emerald-600/20"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.178L2 22l4.98-1.395A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
          </svg>
          Chat WhatsApp
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex md:hidden items-center">
        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="p-2.5 rounded-xl text-gray-700 hover:text-indigo-600 hover:bg-gray-100 focus:outline-none transition-colors"
          aria-label="Toggle Menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white px-4 pt-3 pb-6 space-y-3 shadow-lg">
    <a href="/" class="block px-3 py-2 rounded-lg text-base font-semibold text-gray-800 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">
      Home
    </a>
    <a href="/about" class="block px-3 py-2 rounded-lg text-base font-semibold text-gray-800 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">
      About Us
    </a>
    <a href="/packages" class="block px-3 py-2 rounded-lg text-base font-semibold text-gray-800 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">
      Paket Layanan
    </a>
    <a href="/contact" class="block px-3 py-2 rounded-lg text-base font-semibold text-gray-800 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">
      Kontak & Cabang
    </a>
    <div class="pt-2">
      <a 
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition-colors shadow-md"
      >
        Chat WhatsApp Admin
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
