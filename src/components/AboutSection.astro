---
import { siteConfig } from "../data/siteConfig.js";
const waLink = siteConfig.getWaLink(
  "Halo Admin SterlinkNet, saya ingin mengetahui lebih lanjut tentang profil perusahaan dan layanan internet Anda.",
);
---

<section id="about" class="py-20 bg-gray-50 border-y border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-4">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-100/80 text-indigo-700 text-xs font-bold uppercase tracking-wider"
      >
        Tentang {siteConfig.company.name}
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight">
        Dedikasi Konektivitas Digital Berkualitas ({
          siteConfig.company.establishedYear
        })
      </h2>
      <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
        {siteConfig.company.aboutDescription}
      </p>
    </div>

    <!-- 3 Core Pillars -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Card 1: Kehandalan & Uptime -->
      <div
        class="bg-white p-8 rounded-2xl border border-gray-200/80 shadow-xs hover:shadow-md transition-shadow"
      >
        <div
          class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-6"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div class="text-3xl font-black text-gray-900 mb-2">99.5% Uptime</div>
        <h3 class="text-lg font-bold text-gray-800 mb-2">
          Koneksi Stabil & Handal
        </h3>
        <p class="text-sm text-gray-600 leading-relaxed">
          Menjamin koneksi internet berkecepatan tinggi tanpa kompromi untuk
          kenyamanan aktivitas online keluarga dan bisnis Anda.
        </p>
      </div>

      <!-- Card 2: 100% Fiber Optic murni -->
      <div
        class="bg-white p-8 rounded-2xl border border-gray-200/80 shadow-xs hover:shadow-md transition-shadow"
      >
        <div
          class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-6"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <div class="text-3xl font-black text-gray-900 mb-2">100% Fiber</div>
        <h3 class="text-lg font-bold text-gray-800 mb-2">
          Infrastruktur Modern
        </h3>
        <p class="text-sm text-gray-600 leading-relaxed">
          Menggunakan kabel serat optik mutakhir untuk menjamin kestabilan
          jaringan, transmisi minim gangguan, dan latency terendah.
        </p>
      </div>

      <!-- Card 3: Layanan Responsif -->
      <div
        class="bg-white p-8 rounded-2xl border border-gray-200/80 shadow-xs hover:shadow-md transition-shadow"
      >
        <div
          class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-6"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
        </div>
        <div class="text-3xl font-black text-gray-900 mb-2">24 / 7</div>
        <h3 class="text-lg font-bold text-gray-800 mb-2">
          Technical Support Siaga
        </h3>
        <p class="text-sm text-gray-600 leading-relaxed">
          Tim Network Operation Center (NOC) dan teknisi lapangan siap membantu
          kapan pun Anda memerlukan bantuan.
        </p>
      </div>
    </div>

    <!-- Vision & Mission Banner -->
    <div
      class="mt-12 bg-white rounded-3xl p-8 sm:p-12 border border-gray-200 shadow-sm grid grid-cols-1 md:grid-cols-2 gap-8 items-center"
    >
      <div>
        <h3 class="text-2xl font-black text-gray-900 mb-3">Visi Kami</h3>
        <p class="text-gray-600 text-sm sm:text-base leading-relaxed">
          {siteConfig.company.vision}
        </p>
      </div>
      <div class="md:border-l md:border-gray-200 md:pl-8">
        <h3 class="text-2xl font-black text-gray-900 mb-3">Misi Kami</h3>
        <p class="text-gray-600 text-sm sm:text-base leading-relaxed">
          {siteConfig.company.mission}
        </p>
      </div>
    </div>

    <!-- Bottom CTA to WA -->
    <div class="mt-12 text-center">
      <a
        href={waLink}
        target="_blank"
        class="inline-flex items-center gap-2 text-sm font-bold text-indigo-600 hover:text-indigo-700 bg-indigo-50 hover:bg-indigo-100 px-6 py-3 rounded-xl transition-colors"
      >
        Tanya Lebih Lanjut ke Admin Perusahaan &rarr;
      </a>
    </div>
  </div>
</section>
