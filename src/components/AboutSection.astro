---
import { siteConfig } from "../data/siteConfig.js";
const waLink = siteConfig.getWaLink(
  "Halo Admin SterlinkNet, saya ingin mengetahui lebih lanjut tentang profil perusahaan dan layanan internet Anda.",
);
---

<section id="about" class="py-20 bg-[#0d0d2b] border-y border-indigo-500/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-4">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 text-indigo-300 text-xs font-bold uppercase tracking-wider border border-indigo-500/20"
      >
        Tentang <img src="/images/sterlink-name.png" alt={siteConfig.company.name} class="h-3 w-auto inline-block brightness-0 invert" />
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-white flex flex-wrap justify-center items-center gap-3">
        Tentang 
        <img src="/images/sterlink-name.png" alt={siteConfig.company.name} class="h-8 sm:h-10 w-auto inline-block brightness-0 invert -mt-1" />
        Dedikasi Konektivitas Digital Berkualitas ({siteConfig.company.establishedYear})
      </h2>
      <p class="text-base sm:text-lg text-gray-400 leading-relaxed">
        {siteConfig.company.aboutDescription}
      </p>
    </div>

    <!-- 3 Core Pillars -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Card 1: Kehandalan & Uptime -->
      <div
        class="glass-card p-8 rounded-2xl hover:border-indigo-500/30 transition-all duration-300 group"
      >
        <div
          class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center mb-6 group-hover:bg-indigo-500/20 transition-colors"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-blue-400 mb-2">99.5% Uptime</div>
        <h3 class="text-lg font-bold text-white mb-2">
          Koneksi Stabil & Handal
        </h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          Menjamin koneksi internet berkecepatan tinggi tanpa kompromi untuk
          kenyamanan aktivitas online keluarga dan bisnis Anda.
        </p>
      </div>

      <!-- Card 2: 100% Fiber Optic murni -->
      <div
        class="glass-card p-8 rounded-2xl hover:border-blue-500/30 transition-all duration-300 group"
      >
        <div
          class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center mb-6 group-hover:bg-blue-500/20 transition-colors"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <div class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-400 mb-2">100% Fiber</div>
        <h3 class="text-lg font-bold text-white mb-2">
          Infrastruktur Modern
        </h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          Menggunakan kabel serat optik mutakhir untuk menjamin kestabilan
          jaringan, transmisi minim gangguan, dan latency terendah.
        </p>
      </div>

      <!-- Card 3: Layanan Responsif -->
      <div
        class="glass-card p-8 rounded-2xl hover:border-emerald-500/30 transition-all duration-300 group"
      >
        <div
          class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-6 group-hover:bg-emerald-500/20 transition-colors"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </div>
        <div class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-green-400 mb-2">24 / 7</div>
        <h3 class="text-lg font-bold text-white mb-2">
          Technical Support Siaga
        </h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          Tim Network Operation Center (NOC) dan teknisi lapangan siap membantu
          kapan pun Anda memerlukan bantuan.
        </p>
      </div>
    </div>

    <!-- Vision & Mission Banner -->
    <div
      class="mt-12 glass-card rounded-3xl p-8 sm:p-12 grid grid-cols-1 md:grid-cols-2 gap-8 items-center"
    >
      <div>
        <h3 class="text-2xl font-black text-white mb-3">Visi Kami</h3>
        <p class="text-gray-400 text-sm sm:text-base leading-relaxed">
          {siteConfig.company.vision}
        </p>
      </div>
      <div class="md:border-l md:border-indigo-500/20 md:pl-8">
        <h3 class="text-2xl font-black text-white mb-3">Misi Kami</h3>
        <p class="text-gray-400 text-sm sm:text-base leading-relaxed">
          {siteConfig.company.mission}
        </p>
      </div>
    </div>

    <!-- Bottom CTA to WA -->
    <div class="mt-12 text-center">
      <a
        href={waLink}
        target="_blank"
        class="inline-flex items-center gap-2 text-sm font-bold text-indigo-300 hover:text-indigo-200 bg-indigo-500/10 hover:bg-indigo-500/20 px-6 py-3 rounded-xl transition-colors border border-indigo-500/20"
      >
        Tanya Lebih Lanjut ke Admin Perusahaan &rarr;
      </a>
    </div>
  </div>
</section>
