---
import { siteConfig } from '../data/siteConfig.js';
const waLink = siteConfig.getWaLink("Halo Admin SterlinkNet, saya butuh bantuan informasi paket internet.");
---

<!-- Sticky Floating WhatsApp Button -->
<div class="fixed bottom-6 right-6 z-50 flex items-center group">
  <!-- Hover Tooltip -->
  <div class="hidden sm:block mr-3 px-3.5 py-1.5 rounded-full bg-[#0f0f2a] text-gray-200 text-xs font-bold shadow-lg border border-indigo-500/15 opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none whitespace-nowrap">
    💬 Chat Admin ({siteConfig.contact.whatsappDisplay})
  </div>

  <a
    href={waLink}
    target="_blank"
    rel="noopener noreferrer"
    class="relative w-14 h-14 rounded-full bg-emerald-500 hover:bg-emerald-400 active:scale-95 text-white flex items-center justify-center shadow-xl shadow-emerald-500/30 transition-all hover:scale-110"
    aria-label="Hubungi WhatsApp Admin"
  >
    <!-- Pulse wave effect -->
    <span class="absolute inset-0 rounded-full bg-emerald-400 opacity-75 animate-ping -z-10"></span>

    <!-- WhatsApp SVG Icon -->
    <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.178L2 22l4.98-1.395A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
    </svg>
  </a>
</div>
